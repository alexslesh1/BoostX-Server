# Copy this file to `.env` and fill in real values for local development.
# In Docker/production, these are typically passed as real environment
# variables instead of a mounted .env file.

# --- Database ---
# asyncpg driver is required (postgresql+asyncpg://...), not plain postgresql://
DATABASE_URL=postgresql+asyncpg://boostx:boostx@localhost:5432/boostx

# --- JWT ---
# Generate a strong random value in production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# --- Verification codes (email verify / password reset / email change) ---
VERIFICATION_CODE_EXPIRE_MINUTES=10

# --- Email ---
# EMAIL_BACKEND=console logs the code to stdout instead of sending real email
# (use this for local dev without SMTP credentials). Set to "smtp" to send
# real email via aiosmtplib using the SMTP_* settings below.
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@boostx.app
SMTP_USE_TLS=true

# --- App ---
APP_ENV=local
# DEBUG=true includes exception detail in 500 responses and enables SQL echo.
# Always set DEBUG=false in production.
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
# "*" (default) is convenient for local dev but must be locked down in production.
CORS_ORIGINS=*

# --- Devices ---
# Maximum number of devices a single account may have registered at once.
# 0 = unlimited.
MAX_DEVICES_PER_USER=5

# --- Rate limiting ---
# Storage backend for slowapi rate limiting. Leave empty for in-memory
# (fine for a single process). Set to a Redis URI to share limits across
# multiple app instances/workers, e.g. redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=
