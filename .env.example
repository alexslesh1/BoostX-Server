# Copy this file to `.env` and fill in real values for local development.
# In Docker/production, these are typically passed as real environment
# variables instead of a mounted .env file.

# --- Database ---
# asyncpg driver is required (postgresql+asyncpg://...), not plain postgresql://
DATABASE_URL=postgresql+asyncpg://boostx:boostx@localhost:5432/boostx

# --- JWT ---
# Generate a strong random value in production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# --- Verification codes (email verify / password reset / email change) ---
VERIFICATION_CODE_EXPIRE_MINUTES=10

# --- Email ---
# EMAIL_BACKEND=console logs the code to stdout instead of sending real email
# (use this for local dev without SMTP credentials). Set to "smtp" to send
# real email via aiosmtplib using the SMTP_* settings below.
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@boostx.app
SMTP_USE_TLS=true

# --- App ---
APP_ENV=local
# DEBUG=true includes exception detail in 500 responses and enables SQL echo.
# Always set DEBUG=false in production.
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
# "*" (default) is convenient for local dev but must be locked down in production.
CORS_ORIGINS=*

# --- Devices ---
# Maximum number of devices a single account may have registered at once.
# 0 = unlimited.
MAX_DEVICES_PER_USER=5

# --- Rate limiting ---
# Storage backend for slowapi rate limiting. Leave empty for in-memory
# (fine for a single process). Set to a Redis URI to share limits across
# multiple app instances/workers, e.g. redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=

# --- Boost Discord (per-user SOCKS5 proxy relay) ---
# Public address:port of the 3proxy relay the desktop client connects to.
PROXY_HOST=194.87.200.215
PROXY_PORT=1080
# Fernet key used to encrypt proxy passwords at rest (they must be
# recoverable in plaintext to authenticate the client and to write
# 3proxy's users file — never hash this like a login password). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROXY_CREDENTIALS_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
# Path to 3proxy's `users` auth file (format: login:CL:password, one per
# line). Assumes this app server runs on the same host as 3proxy.
PROXY_3PROXY_USERS_FILE=/usr/local/etc/3proxy/conf/users
# Command run after rewriting the users file so 3proxy reloads it. The app
# server's OS user needs permission to run this — e.g. a sudoers rule
# scoped to exactly this one command. Never grant broad sudo access for it.
PROXY_3PROXY_RELOAD_COMMAND=systemctl reload 3proxy
# If false, credentials are still generated and stored in the database but
# the users file is never written/reloaded — useful for local dev.
PROXY_SYNC_3PROXY_FILE=true
